<!DOCTYPE html>
<html>
<head>
    <title><%= user.firstName %> <%= user.lastName %> | Family Profile</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 40px;
        }

        .container {
            max-width: 800px;
            margin: auto;
        }

        .profile,
        .child {
            background: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        h1, h2, h3 {
            color: #333;
        }

        p {
            color: #555;
        }

        button,
        a {
            padding: 9px 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            margin-right: 5px;
        }

        .add {
            background-color: #198754;
            color: white;
        }

        .update {
            background-color: #0d6efd;
            color: white;
        }

        .delete {
            background-color: #dc3545;
            color: white;
        }

        .children-link {
            background-color: #6c757d;
            color: white;
        }

        .update-form {
            display: none;
            margin-top: 15px;
        }

        input {
            display: block;
            width: 90%;
            padding: 8px;
            margin: 8px 0;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="profile">

        <h1>
            <%= user.firstName %> <%= user.lastName %>
        </h1>

        <p>
            <strong>Email:</strong> <%= user.email %>
        </p>

        <p>
            <strong>Phone:</strong> <%= user.phone %>
        </p>

        <a class="add" href="/users/<%= user._id %>/add-child">
            Add Child
        </a>

        <a class="children-link"
           href="/users/<%= user._id %>/children">
            View All Children
        </a>

    </div>

    <h2>Children</h2>

    <% if (children.length === 0) { %>

        <div class="child">
            <p>No children found for this user.</p>
        </div>

    <% } else { %>

        <% children.forEach(child => { %>

            <div class="child">

                <h3>
                    <%= child.firstName %> <%= child.lastName %>
                </h3>

                <a href="/users/<%= user._id %>/children/<%= child._id %>">
    View Child
</a>

                <p>
                    <strong>Age:</strong>
                    <%= child.age %>
                </p>

                <p>
                    <strong>Email:</strong>
                    <%= child.email %>
                </p>

                <button
                    class="update"
                    onclick="showUpdateForm('<%= child._id %>')">
                    Update
                </button>

                <button
                    class="delete"
                    onclick="deleteChild('<%= child._id %>')">
                    Delete
                </button>

                <div
                    class="update-form"
                    id="form-<%= child._id %>">

                    <input
                        id="firstName-<%= child._id %>"
                        value="<%= child.firstName %>"
                        placeholder="First Name">

                    <input
                        id="lastName-<%= child._id %>"
                        value="<%= child.lastName %>"
                        placeholder="Last Name">

                    <input
                        id="age-<%= child._id %>"
                        type="number"
                        value="<%= child.age %>"
                        placeholder="Age">

                    <input
                        id="email-<%= child._id %>"
                        value="<%= child.email %>"
                        placeholder="Email">

                    <button
                        class="update"
                        onclick="updateChild('<%= child._id %>')">
                        Save Changes
                    </button>

                </div>

            </div>

        <% }) %>

    <% } %>

</div>

<script>

function showUpdateForm(childId) {
    const form = document.getElementById('form-' + childId);

    if (form.style.display === 'block') {
        form.style.display = 'none';
    } else {
        form.style.display = 'block';
    }
}

async function updateChild(childId) {

    const firstName =
        document.getElementById('firstName-' + childId).value;

    const lastName =
        document.getElementById('lastName-' + childId).value;

    const age =
        document.getElementById('age-' + childId).value;

    const email =
        document.getElementById('email-' + childId).value;

    const response = await fetch('/children/' + childId, {
        method: 'PATCH',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            firstName,
            lastName,
            age,
            email
        })
    });

    const result = await response.json();

    if (response.ok) {
        alert('Child updated successfully');
        location.reload();
    } else {
        alert(result.message || 'Failed to update child');
    }
}

async function deleteChild(childId) {

    const confirmDelete =
        confirm('Are you sure you want to delete this child?');

    if (!confirmDelete) {
        return;
    }

    const response = await fetch('/children/' + childId, {
        method: 'DELETE'
    });

    const result = await response.json();

    if (response.ok) {
        alert('Child deleted successfully');
        location.reload();
    } else {
        alert(result.message || 'Failed to delete child');
    }
}

</script>

</body>
</html>